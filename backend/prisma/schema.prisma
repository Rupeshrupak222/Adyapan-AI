model AptitudeSession {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  mode            String   // practice, timed_quiz, topic_test, company_test, adaptive, daily_challenge, revision
  company         String?  // TCS, Infosys, etc.
  role            String?  // target role
  category        String?  // quantitative, logical, verbal, data_interpretation, analytical
  topic           String?
  difficulty      String   @default("medium") // easy, medium, hard, adaptive
  questionsJson   Json     @map("questions_json")
  totalQuestions  Int      @map("total_questions")
  score           Int      @default(0)
  accuracy        Float    @default(0)
  totalTimeMs     Int      @default(0) @map("total_time_ms")
  avgTimePerQMs   Int      @default(0) @map("avg_time_per_q_ms")
  xpEarned        Int      @default(0) @map("xp_earned")
  streakMaintained Boolean @default(false) @map("streak_maintained")
  weakTopics      String[] @default([]) @map("weak_topics")
  strongTopics    String[] @default([]) @map("strong_topics")
  reportJson      Json?    @map("report_json")
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([mode])
  @@index([company])
  @@index([createdAt])
  @@map("aptitude_sessions")
}


model AptitudeAnswer {
  id              String   @id @default(cuid())
