  postedDate      DateTime? @map("posted_date")
  isGovernment    Boolean  @default(false) @map("is_government")
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  savedBy         JobListingSaved[]
  applications    JobListingApplication[]

  @@index([company])
  @@index([location])
  @@index([mode])
  @@index([employmentType])
  @@index([category])
  @@index([skills])
  @@index([postedDate])
  @@index([createdAt])
  @@index([source])
  @@index([isActive, postedDate])
  @@map("job_listings")
}


model JobListingSaved {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  jobListingId String   @map("job_listing_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  jobListing  JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, jobListingId])
  @@map("job_listing_saved")
}


model JobListingApplication {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  jobListingId String   @map("job_listing_id")
  status      String     @default("applied")
  notes       String?    @default("")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  jobListing  JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobListingId])
  @@unique([userId, jobListingId])
  @@index([userId, status])
  @@map("job_listing_applications")
}


model ResumeImprovement {
