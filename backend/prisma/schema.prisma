  salaryMin       Int?     @map("salary_min")
  salaryMax       Int?     @map("salary_max")
  salaryCurrency  String   @default("INR") @map("salary_currency")
  experienceMin   Int?     @map("experience_min")
  experienceMax   Int?     @map("experience_max")
  employmentType  String   @default("Full-Time") @map("employment_type")
  workMode        String   @default("Onsite") @map("work_mode")
  skills          String[] @default([])
  requirements    String[] @default([])
  responsibilities String[] @default([])
  benefits        String[] @default([])
  education       String   @default("")
  industry        String   @default("")
  companySize     String   @default("") @map("company_size")
  applyUrl        String?  @map("apply_url")
  sourceUrl       String?  @map("source_url")
  source          String
  postedAt        DateTime? @map("posted_at")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  isActive        Boolean  @default(true) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  viewCount       Int      @default(0) @map("view_count")
  saveCount       Int      @default(0) @map("save_count")
  sourceCount     Int      @default(1) @map("source_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([fingerprint])
  @@index([company])
  @@index([source])
  @@index([workMode])
  @@index([employmentType])
  @@index([location])
  @@index([postedAt])
  @@index([isActive])
