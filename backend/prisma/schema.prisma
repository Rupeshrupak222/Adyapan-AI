generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  githubId  String?  @unique @map("github_id")
  googleId  String?  @unique @map("google_id")
  avatarUrl String?  @map("avatar_url")
 activeSessionId String? @map("active_session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile   Profile?

  // Payment / Subscription Relations
  plan                String   @default("free")
  razorpayCustomerId  String?  @map("razorpay_customer_id")
  razorpaySubscriptionId String? @map("razorpay_subscription_id")
  subscriptionStatus  String?  @map("subscription_status")
  subscriptionEnd     DateTime? @map("subscription_end")
  payments            Payment[]

  // Registration Workflow Relations
  settings              UserSettings?
  aiPreference          AiPreference?
  notificationPreference NotificationPreference?
  learningPreference    LearningPreference?
  activityLogs          ActivityLog[]
  sessions              Session[]
  storageUsage          StorageUsage?
  subscriptions         Subscription[]
  aiUsage               AiUsage?
  featureQuotas         UserFeatureQuota[]

  @@index([plan, subscriptionStatus])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  college           String?
  branch            String?
  phone             String?
  year              String?
  careerGoal        String?  @map("career_goal")
  skills            String[] @default([])
  linkedin          String?
  github            String?
  resumeUrl         String?  @map("resume_url")
  resumeName        String?  @map("resume_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  aboutMe           String?  @map("about_me")
  careerObjective   String?  @map("career_objective")
  degree            String?
  graduationYear    String?  @map("graduation_year")
  interestedDomains String[] @default([]) @map("interested_domains")
  location          String?
  portfolio         String?
  photoUrl          String?  @map("photo_url")
  targetRole        String?  @map("target_role")
  username          String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Registration Workflow Fields
  organizationId    String?  @map("organization_id")
  country           String?
  state             String?
  city              String?
  department        String?
  course            String?
  semester          String?
  studentId         String?  @map("student_id")
  referralCode      String?  @map("referral_code")
  profileCompletion Int      @default(0) @map("profile_completion")
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("profiles")
}

model Payment {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  orderId        String    @unique @map("order_id")
  paymentId      String?   @unique @map("payment_id")
  signature      String?   @map("signature")
  amount         Int
  currency       String    @default("INR")
  plan           String
  billingCycle   String?   @map("billing_cycle")
  provider       String    @default("razorpay")
  couponCode     String?   @map("coupon_code")
  discountAmount Int?      @map("discount_amount")
  status         String    @default("created")
  failureReason  String?   @map("failure_reason")
  invoiceNumber  String?   @map("invoice_number")
  refundId       String?   @map("refund_id")
  refundStatus   String?   @map("refund_status")
  refundedAt     DateTime? @map("refunded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}

// ─── AI Usage / Premium Upgrade Flow ──────────────────────────────────────

// Per-user aggregated usage counters (user_usage). One row per user, held on
// the master DB so quotas are enforced consistently across all user databases.
model AiUsage {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  plan               String    @default("free")
  subscriptionStatus String?   @map("subscription_status")
  dailyTokensUsed    Int       @default(0) @map("daily_tokens_used")
  monthlyTokensUsed  Int       @default(0) @map("monthly_tokens_used")
  dailyRequests      Int       @default(0) @map("daily_requests")
  monthlyRequests    Int       @default(0) @map("monthly_requests")
  dailyResetAt       DateTime  @map("daily_reset_at")
  monthlyResetAt     DateTime  @map("monthly_reset_at")
  lastRequestAt      DateTime? @map("last_request_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([dailyResetAt])
  @@map("ai_usage")
}

// Granular per-request token/request log (token_usage + ai_requests).
model AiRequestLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  plan          String   @default("free")
  route         String?
  method        String?
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  status        String   @default("success")
  blocked       Boolean  @default(false)
  blockedReason String?  @map("blocked_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_request_logs")
}

// Subscription lifecycle rows linked to premium/enterprise purchases.
model Subscription {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  planId                    String?   @map("plan_id")
  planCode                  String    @map("plan_code")
  billingCycle              String    @default("monthly") @map("billing_cycle")
  status                    String    @default("active")
  provider                  String    @default("razorpay")
  providerSubscriptionId    String?   @map("provider_subscription_id")
  price                     Float     @default(0)
  currency                  String    @default("INR")
  autoRenew                 Boolean   @default(true) @map("auto_renew")
  currentPeriodStart        DateTime  @map("current_period_start")
  currentPeriodEnd          DateTime  @map("current_period_end")
  cancellationRequestedAt   DateTime? @map("cancellation_requested_at")
  canceledAt                DateTime? @map("canceled_at")
  endedAt                   DateTime? @map("ended_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([planCode])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// Billing ledger events (payment, upgrade, downgrade, cancellation).
model Billing {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  event     String   @map("billing_event")
  amount    Float    @default(0)
  currency  String   @default("INR")
  plan      String?
  status    String   @default("completed")
  reference String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@map("billing_events")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   @default("UNIVERSITY")
  code         String?
  location     String?
  domain       String?
  contactEmail String?  @map("contact_email")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Registration Workflow Statistics
  country              String?
  studentCount         Int       @default(0) @map("student_count")
  activeStudents       Int       @default(0) @map("active_students")
  courseCount          Int       @default(0) @map("course_count")
  departmentCount      Int       @default(0) @map("department_count")
  branchCount          Int       @default(0) @map("branch_count")
  registrationCount    Int       @default(0) @map("registration_count")
  latestRegistrationAt DateTime? @map("latest_registration_at")

  profiles    Profile[]
  departments UniversityDepartment[]
  courses     UniversityCourse[]
  branches    UniversityBranch[]

  @@index([type])
  @@index([name])
  @@map("organizations")
}

// ─── Registration Workflow: Per-User Defaults ────────────────────────────

// Persistent settings for the Settings page (theme, privacy, security, ...).
model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")

  // Appearance
  themeMode          String   @default("dark")     @map("theme_mode")
  accentColor        String   @default("#f59e0b")  @map("accent_color")
  compactMode        Boolean  @default(false)      @map("compact_mode")
  glassEffect        Boolean  @default(true)       @map("glass_effect")
  animationsEnabled  Boolean  @default(true)       @map("animations_enabled")
  sidebarCollapse    Boolean  @default(true)       @map("sidebar_collapse")
  fontSize           Int      @default(14)         @map("font_size")

  // Privacy
  publicProfile      Boolean  @default(true)       @map("public_profile")
  dataCollection     Boolean  @default(true)       @map("data_collection")
  personalizedAi     Boolean  @default(true)       @map("personalized_ai")

  // Security
  twoFactorEnabled   Boolean  @default(false)      @map("two_factor_enabled")
  loginAlerts        Boolean  @default(true)       @map("login_alerts")

  // Connected Accounts
  googleConnected    Boolean  @default(false)      @map("google_connected")
  githubConnected    Boolean  @default(false)      @map("github_connected")
  microsoftConnected Boolean  @default(false)      @map("microsoft_connected")
  linkedinConnected  Boolean  @default(false)      @map("linkedin_connected")

  createdAt          DateTime @default(now())      @map("created_at")
  updatedAt          DateTime @updatedAt           @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Default AI preferences (model, temperature, output behaviour).
model AiPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  provider            String   @default("openrouter")
  aiModel             String   @default("gemini")      @map("ai_model")
  creativity          Int      @default(70)
  responseLength      String   @default("balanced")    @map("response_length")
  aiMemory            Boolean  @default(true)          @map("ai_memory")
  markdownOutput      Boolean  @default(true)          @map("markdown_output")
  codeHighlighting    Boolean  @default(true)          @map("code_highlighting")
  autoCitation        Boolean  @default(false)         @map("auto_citation")
  autoSaveConversations Boolean @default(true)         @map("auto_save_conversations")
  maxTokens           Int      @default(4096)          @map("max_tokens")
  createdAt           DateTime @default(now())         @map("created_at")
  updatedAt           DateTime @updatedAt              @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_preferences")
}

// Default notification preferences.
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  email          Boolean  @default(true)
  push           Boolean  @default(true)
  assignment     Boolean  @default(true) @map("notif_assignment")
  interview      Boolean  @default(true) @map("notif_interview")
  coding         Boolean  @default(false) @map("notif_coding")
  research       Boolean  @default(false) @map("notif_research")
  weekly         Boolean  @default(true) @map("notif_weekly")
  daily          Boolean  @default(true) @map("notif_daily")
  marketing      Boolean  @default(false)
  announcements  Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Default learning preferences.
model LearningPreference {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  language        String   @default("en")
  learningStyle   String   @default("visual")       @map("learning_style")
  dailyGoal       Int      @default(3)              @map("daily_goal")
  reminderTime    String   @default("09:00")        @map("reminder_time")
  difficulty      String   @default("intermediate")
  noteFormat      String   @default("markdown")     @map("note_format")
  quizDifficulty  String   @default("medium")       @map("quiz_difficulty")
  tutorPersonality String  @default("friendly")     @map("tutor_personality")
  studyReminders  Boolean  @default(true)           @map("study_reminders")
  createdAt       DateTime @default(now())          @map("created_at")
  updatedAt       DateTime @updatedAt               @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_preferences")
}

// Persistent trail of significant account / registration actions.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  category  String   @default("account")
  details   Json     @default("{}")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// Authenticated sessions (created at registration / login for auditability).
model Session {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  tokenHash        String   @unique @map("token_hash")
  refreshTokenHash String?  @unique @map("refresh_token_hash")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at")
  lastActiveAt     DateTime? @map("last_active_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Storage allocation snapshot per user (free tier default).
model StorageUsage {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  limitMb    Float    @default(50)  @map("limit_mb")
  usedMb     Float    @default(0)   @map("used_mb")
  notes      Int      @default(0)
  resumes    Int      @default(0)
  assignments Int     @default(0)
  sessions   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("storage_usage")
}

// ─── Registration Workflow: University / Course Statistics ───────────────

model UniversityDepartment {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  name             String
  studentCount     Int      @default(0) @map("student_count")
  registrationCount Int     @default(0) @map("registration_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("university_departments")
}

model UniversityCourse {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  name             String
  department       String?
  studentCount     Int      @default(0) @map("student_count")
  registrationCount Int     @default(0) @map("registration_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("university_courses")
}

model UniversityBranch {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  name             String
  department       String?
  course           String?
  studentCount     Int      @default(0) @map("student_count")
  registrationCount Int     @default(0) @map("registration_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("university_branches")
}

// Daily registration rollup — powers admin registration analytics / growth charts.
model RegistrationDailyMetric {
  id             String   @id @default(cuid())
  date           DateTime @unique
  registrations  Int      @default(0)
  newUniversities Int     @default(0) @map("new_universities")
  newDepartments Int      @default(0) @map("new_departments")
  newCourses     Int      @default(0) @map("new_courses")
  newBranches    Int      @default(0) @map("new_branches")
  newCountries   Int      @default(0) @map("new_countries")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("registration_daily_metrics")
}

enum Role {
  USER
  ADMIN
}

model CodingQuestion {
  id                  String   @id @default(cuid())
  externalId          String   @unique @map("external_id")
  source              String
  title               String
  problemUrl          String   @map("problem_url")
  difficulty          String
  rating              Int?
  topic               String
  tagsJson            Json     @map("tags_json")
  placementImportance Boolean  @default(false) @map("placement_importance")
  interviewImportance Boolean  @default(false) @map("interview_importance")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  aiAnalyses          QuestionAIAnalysis[]
  dailyChallenges     DailyChallenge[]

  @@map("coding_questions")
}

model UserQuestionProgress {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  questionId     String   @map("question_id")
  status         String   @default("unsolved")
  viewed         Boolean  @default(false)
  attempted      Boolean  @default(false)
  solved         Boolean  @default(false)
  bookmarked     Boolean  @default(false)
  timeSpent      Int      @default(0) @map("time_spent")
  runCount       Int      @default(0) @map("run_count")
  successfulRuns Int      @default(0) @map("successful_runs")
  failedRuns     Int      @default(0) @map("failed_runs")
  languageUsage  Json     @default("{}") @map("language_usage")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId])
  @@map("user_question_progress")
}

model QuestionAIAnalysis {
  id                 String         @id @default(cuid())
  questionId         String         @map("question_id")
  explanationJson    Json           @map("explanation_json")
  generatedByModel   String         @map("generated_by_model")
  generatedAt        DateTime       @default(now()) @map("generated_at")
  question           CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_ai_analysis")
}

model DailyChallenge {
  id            String         @id @default(cuid())
  questionId    String         @map("question_id")
  challengeDate DateTime       @map("challenge_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  question      CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("daily_challenges")
}

model CareerRoadmap {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  targetRole        String   @map("target_role")
  timeline          String   @default("90 Days")
  readinessScore    Int      @default(0) @map("readiness_score")
  technicalScore    Int      @default(0) @map("technical_score")
  resumeScore       Int      @default(0) @map("resume_score")
  interviewScore    Int      @default(0) @map("interview_score")
  placementScore    Int      @default(0) @map("placement_score")
  recruiterScore    Int      @default(0) @map("recruiter_score")
  roadmapJson       Json     @map("roadmap_json")
  weeklyPlanJson    Json     @map("weekly_plan_json")
  gapAnalysisJson   Json     @map("gap_analysis_json")
  skillMapJson      Json     @map("skill_map_json")
  projectRecsJson   Json     @map("project_recs_json")
  certRecsJson      Json     @map("cert_recs_json")
  marketInsightsJson Json    @map("market_insights_json")
  coachFeedbackJson Json     @map("coach_feedback_json")
  milestonesJson    Json     @map("milestones_json")
  versionNumber     Int      @default(1) @map("version_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tasks             CareerTask[]

  @@index([userId])
  @@index([createdAt])
  @@map("career_roadmaps")
}

model CareerTask {
  id              String        @id @default(cuid())
  roadmapId       String        @map("roadmap_id")
  userId          String        @map("user_id")
  title           String
  description     String        @default("")
  category        String        @default("learning")
  priority        String        @default("Medium")
  status          String        @default("not_started")
  estimatedHours  Float         @default(1) @map("estimated_hours")
  impactScore     Int           @default(50) @map("impact_score")
  dueDate         DateTime?     @map("due_date")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  roadmap         CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([userId])
  @@index([status])
  @@map("career_tasks")
}

model CareerDashboardSnapshot {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  overallReadiness  Int      @map("overall_readiness")
  codingScore       Int      @map("coding_score")
  learningScore     Int      @map("learning_score")
  resumeScore       Int      @map("resume_score")
  atsScore          Int      @map("ats_score")
  linkedinScore     Int      @map("linkedin_score")
  dashboardJson     Json     @map("dashboard_json")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("career_dashboard_snapshots")
}

model ResearchPaper {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  domain        String   @default("General Science")
  abstract      String   @db.Text
  keywords      String[] @default([])
  contentJson   Json     @map("content_json")
  status        String   @default("DRAFT")
  template      String   @default("IEEE")
  citationStyle String   @default("IEEE") @map("citation_style")
  wordCount     Int      @default(0) @map("word_count")
  pageCount     Int      @default(1) @map("page_count")
  readingTime   Int      @default(1) @map("reading_time")
  isFavorite    Boolean  @default(false) @map("is_favorite")
  authors       Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("research_papers")
}

model PaperDraft {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  domain      String   @default("Computer Science")
  currentStep Int      @default(1) @map("current_step")
  configJson  Json     @map("config_json")
  contentJson Json     @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt])
