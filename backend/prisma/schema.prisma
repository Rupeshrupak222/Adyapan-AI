generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(USER)
  githubId  String?  @unique @map("github_id")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  profile   Profile?

  // Payment / Subscription Relations
  plan                String   @default("free")
  razorpayCustomerId  String?  @map("razorpay_customer_id")
  razorpaySubscriptionId String? @map("razorpay_subscription_id")
  subscriptionStatus  String?  @map("subscription_status")
  subscriptionEnd     DateTime? @map("subscription_end")
  payments            Payment[]

  @@index([plan, subscriptionStatus])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  college           String?
  branch            String?
  phone             String?
  year              String?
  careerGoal        String?  @map("career_goal")
  skills            String[] @default([])
  linkedin          String?
  github            String?
  resumeUrl         String?  @map("resume_url")
  resumeName        String?  @map("resume_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  aboutMe           String?  @map("about_me")
  careerObjective   String?  @map("career_objective")
  degree            String?
  graduationYear    String?  @map("graduation_year")
  interestedDomains String[] @default([]) @map("interested_domains")
  location          String?
  portfolio         String?
  photoUrl          String?  @map("photo_url")
  targetRole        String?  @map("target_role")
  username          String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Payment {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  orderId        String    @unique @map("order_id")
  paymentId      String?   @unique @map("payment_id")
  signature      String?   @map("signature")
  amount         Int
  currency       String    @default("INR")
  plan           String
  billingCycle   String?   @map("billing_cycle")
  provider       String    @default("razorpay")
  couponCode     String?   @map("coupon_code")
  discountAmount Int?      @map("discount_amount")
  status         String    @default("created")
  failureReason  String?   @map("failure_reason")
  invoiceNumber  String?   @map("invoice_number")
  refundId       String?   @map("refund_id")
  refundStatus   String?   @map("refund_status")
  refundedAt     DateTime? @map("refunded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model BlacklistedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blacklisted_tokens")
}

// ─── AI Usage / Premium Upgrade Flow ──────────────────────────────────────

// Per-user aggregated usage counters (user_usage). One row per user, held on
// the master DB so quotas are enforced consistently across all user databases.
model AiUsage {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  plan               String    @default("free")
  subscriptionStatus String?   @map("subscription_status")
  dailyTokensUsed    Int       @default(0) @map("daily_tokens_used")
  monthlyTokensUsed  Int       @default(0) @map("monthly_tokens_used")
  dailyRequests      Int       @default(0) @map("daily_requests")
  monthlyRequests    Int       @default(0) @map("monthly_requests")
  dailyResetAt       DateTime  @map("daily_reset_at")
  monthlyResetAt     DateTime  @map("monthly_reset_at")
  lastRequestAt      DateTime? @map("last_request_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([plan])
  @@index([dailyResetAt])
  @@map("ai_usage")
}

// Granular per-request token/request log (token_usage + ai_requests).
model AiRequestLog {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  plan          String   @default("free")
  route         String?
  method        String?
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  status        String   @default("success")
  blocked       Boolean  @default(false)
  blockedReason String?  @map("blocked_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_request_logs")
}

// Subscription lifecycle rows linked to premium/enterprise purchases.
model Subscription {
  id                        String    @id @default(cuid())
  userId                    String    @map("user_id")
  planId                    String?   @map("plan_id")
  planCode                  String    @map("plan_code")
  billingCycle              String    @default("monthly") @map("billing_cycle")
  status                    String    @default("active")
  provider                  String    @default("razorpay")
  providerSubscriptionId    String?   @map("provider_subscription_id")
  price                     Float     @default(0)
  currency                  String    @default("INR")
  autoRenew                 Boolean   @default(true) @map("auto_renew")
  currentPeriodStart        DateTime  @map("current_period_start")
  currentPeriodEnd          DateTime  @map("current_period_end")
  cancellationRequestedAt   DateTime? @map("cancellation_requested_at")
  canceledAt                DateTime? @map("canceled_at")
  endedAt                   DateTime? @map("ended_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([planCode])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// Billing ledger events (payment, upgrade, downgrade, cancellation).
model Billing {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  event     String   @map("billing_event")
  amount    Float    @default(0)
  currency  String   @default("INR")
  plan      String?
  status    String   @default("completed")
  reference String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@map("billing_events")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id           String   @id @default(cuid())
  name         String   @unique
  type         String   @default("UNIVERSITY")
  code         String?
  location     String?
  domain       String?
  contactEmail String?  @map("contact_email")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([name])
  @@map("organizations")
}

enum Role {
  USER
  ADMIN
}

model CodingQuestion {
  id                  String   @id @default(cuid())
  externalId          String   @unique @map("external_id")
  source              String
  title               String
  problemUrl          String   @map("problem_url")
  difficulty          String
  rating              Int?
  topic               String
  tagsJson            Json     @map("tags_json")
  placementImportance Boolean  @default(false) @map("placement_importance")
  interviewImportance Boolean  @default(false) @map("interview_importance")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  aiAnalyses          QuestionAIAnalysis[]
  dailyChallenges     DailyChallenge[]

  @@map("coding_questions")
}

model UserQuestionProgress {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  questionId     String   @map("question_id")
  status         String   @default("unsolved")
  viewed         Boolean  @default(false)
  attempted      Boolean  @default(false)
  solved         Boolean  @default(false)
  bookmarked     Boolean  @default(false)
  timeSpent      Int      @default(0) @map("time_spent")
  runCount       Int      @default(0) @map("run_count")
  successfulRuns Int      @default(0) @map("successful_runs")
  failedRuns     Int      @default(0) @map("failed_runs")
  languageUsage  Json     @default("{}") @map("language_usage")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId])
  @@map("user_question_progress")
}

model QuestionAIAnalysis {
  id                 String         @id @default(cuid())
  questionId         String         @map("question_id")
  explanationJson    Json           @map("explanation_json")
  generatedByModel   String         @map("generated_by_model")
  generatedAt        DateTime       @default(now()) @map("generated_at")
  question           CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_ai_analysis")
}

model DailyChallenge {
  id            String         @id @default(cuid())
  questionId    String         @map("question_id")
  challengeDate DateTime       @map("challenge_date")
  createdAt     DateTime       @default(now()) @map("created_at")
  question      CodingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("daily_challenges")
}

model CareerRoadmap {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  targetRole        String   @map("target_role")
  timeline          String   @default("90 Days")
  readinessScore    Int      @default(0) @map("readiness_score")
  technicalScore    Int      @default(0) @map("technical_score")
  resumeScore       Int      @default(0) @map("resume_score")
  interviewScore    Int      @default(0) @map("interview_score")
  placementScore    Int      @default(0) @map("placement_score")
  recruiterScore    Int      @default(0) @map("recruiter_score")
  roadmapJson       Json     @map("roadmap_json")
  weeklyPlanJson    Json     @map("weekly_plan_json")
  gapAnalysisJson   Json     @map("gap_analysis_json")
  skillMapJson      Json     @map("skill_map_json")
  projectRecsJson   Json     @map("project_recs_json")
  certRecsJson      Json     @map("cert_recs_json")
  marketInsightsJson Json    @map("market_insights_json")
  coachFeedbackJson Json     @map("coach_feedback_json")
  milestonesJson    Json     @map("milestones_json")
  versionNumber     Int      @default(1) @map("version_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tasks             CareerTask[]

  @@index([userId])
  @@index([createdAt])
  @@map("career_roadmaps")
}

model CareerTask {
  id              String        @id @default(cuid())
  roadmapId       String        @map("roadmap_id")
  userId          String        @map("user_id")
  title           String
  description     String        @default("")
  category        String        @default("learning")
  priority        String        @default("Medium")
  status          String        @default("not_started")
  estimatedHours  Float         @default(1) @map("estimated_hours")
  impactScore     Int           @default(50) @map("impact_score")
  dueDate         DateTime?     @map("due_date")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  roadmap         CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([userId])
  @@index([status])
  @@map("career_tasks")
}

model CareerDashboardSnapshot {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  overallReadiness  Int      @map("overall_readiness")
  codingScore       Int      @map("coding_score")
  learningScore     Int      @map("learning_score")
  resumeScore       Int      @map("resume_score")
  atsScore          Int      @map("ats_score")
  linkedinScore     Int      @map("linkedin_score")
  dashboardJson     Json     @map("dashboard_json")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("career_dashboard_snapshots")
}

model ResearchPaper {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  title         String
  domain        String   @default("General Science")
  abstract      String   @db.Text
  keywords      String[] @default([])
  contentJson   Json     @map("content_json")
  status        String   @default("DRAFT")
  template      String   @default("IEEE")
  citationStyle String   @default("IEEE") @map("citation_style")
  wordCount     Int      @default(0) @map("word_count")
  pageCount     Int      @default(1) @map("page_count")
  readingTime   Int      @default(1) @map("reading_time")
  isFavorite    Boolean  @default(false) @map("is_favorite")
  authors       Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("research_papers")
}

model PaperDraft {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  domain      String   @default("Computer Science")
  currentStep Int      @default(1) @map("current_step")
  configJson  Json     @map("config_json")
  contentJson Json     @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([updatedAt])
  @@map("paper_drafts")
}

model PaperExport {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  paperId     String?  @map("paper_id")
  title       String
  format      String   // pdf, docx, latex, markdown
  template    String   @default("IEEE")
  downloadUrl String?  @map("download_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("paper_exports")
}

model PaperUpload {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  filename      String
  fileSize      Int      @map("file_size")
  parsedText    String   @db.Text @map("parsed_text")
  extractedMeta Json     @map("extracted_meta")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("paper_uploads")
}

model AIResearchLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  paperId    String?  @map("paper_id")
  action     String   // generate_paper, generate_section, enhance, diagram, etc.
  tokensUsed Int      @default(0) @map("tokens_used")
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("ai_research_logs")
}

model CommunityFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([followerId])
  @@index([followingId])
  @@unique([followerId, followingId])
  @@map("community_follows")
}

model CommunityMessage {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("community_messages")
}

model CommunityActivity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  detail    String   @default("")
  xp        Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("community_activities")
}

model CommunityAchievement {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String
  icon        String   @default("trophy")
  xp          Int      @default(0)
  unlockedAt  DateTime @default(now()) @map("unlocked_at")

  @@index([userId])
  @@map("community_achievements")
}

model CommunityProject {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String
  techStack   String[]
  url         String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("community_projects")
}

// ═══════════════════════════════════════════════════════════════════════════
// AI JOB DISCOVERY PLATFORM — Centralized Job Tables (Master DB)
// ═══════════════════════════════════════════════════════════════════════════

model DiscoveryJob {
  id              String   @id @default(cuid())
  fingerprint     String   @unique
  externalId      String?  @map("external_id")
  title           String
  company         String
  companyId       String?  @map("company_id")
  logoUrl         String?  @map("logo_url")
  location        String   @default("")
  country         String   @default("")
  state           String   @default("")
  city            String   @default("")
  description     String   @default("") @db.Text
  salaryMin       Int?     @map("salary_min")
  salaryMax       Int?     @map("salary_max")
  salaryCurrency  String   @default("INR") @map("salary_currency")
  experienceMin   Int?     @map("experience_min")
  experienceMax   Int?     @map("experience_max")
  employmentType  String   @default("Full-Time") @map("employment_type")
  workMode        String   @default("Onsite") @map("work_mode")
  skills          String[] @default([])
  requirements    String[] @default([])
  responsibilities String[] @default([])
  benefits        String[] @default([])
  education       String   @default("")
  industry        String   @default("")
  companySize     String   @default("") @map("company_size")
  applyUrl        String?  @map("apply_url")
  sourceUrl       String?  @map("source_url")
  source          String
  postedAt        DateTime? @map("posted_at")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  isActive        Boolean  @default(true) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  viewCount       Int      @default(0) @map("view_count")
  saveCount       Int      @default(0) @map("save_count")
  sourceCount     Int      @default(1) @map("source_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([fingerprint])
  @@index([company])
  @@index([source])
  @@index([workMode])
  @@index([employmentType])
  @@index([location])
  @@index([postedAt])
  @@index([isActive])
  @@index([skills])
  @@index([salaryMin])
  @@index([experienceMin])
  @@index([createdAt])
  @@map("discovery_jobs")
}

model DiscoveryJobSource {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String   @map("display_name")
  isActive        Boolean  @default(true) @map("is_active")
  schedule        String   @default("daily")
  lastRunAt       DateTime? @map("last_run_at")
  lastRunStatus   String?  @map("last_run_status")
  lastJobsFetched Int      @default(0) @map("last_jobs_fetched")
  lastJobsInserted Int     @default(0) @map("last_jobs_inserted")
  lastDuplicates  Int      @default(0) @map("last_duplicates")
  lastErrors      Int      @default(0) @map("last_errors")
  lastDurationMs  Int      @default(0) @map("last_duration_ms")
  totalJobsFetched Int     @default(0) @map("total_jobs_fetched")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("discovery_job_sources")
}

model DiscoveryCompany {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  logoUrl         String?  @map("logo_url")
  industry        String   @default("")
  companySize     String   @default("") @map("company_size")
  website         String   @default("")
  location        String   @default("")
  techStack       String[] @default([]) @map("tech_stack")
  description     String   @default("")
  jobCount        Int      @default(0) @map("job_count")
  avgSalaryMin    Int?     @map("avg_salary_min")
  avgSalaryMax    Int?     @map("avg_salary_max")
  difficultyLevel String   @default("medium") @map("difficulty_level")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([slug])
  @@index([industry])
  @@index([jobCount])
  @@map("discovery_companies")
}

model DiscoveryIngestionLog {
  id              String   @id @default(cuid())
  source          String
  status          String   @default("running")
  jobsFetched     Int      @default(0) @map("jobs_fetched")
  jobsInserted    Int      @default(0) @map("jobs_inserted")
  jobsUpdated     Int      @default(0) @map("jobs_updated")
  duplicatesRemoved Int   @default(0) @map("duplicates_removed")
  errors          Int      @default(0)
  errorDetails    String?  @map("error_details") @db.Text
  durationMs      Int      @default(0) @map("duration_ms")
  startedAt       DateTime @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@index([source])
  @@index([status])
  @@index([startedAt])
  @@map("discovery_ingestion_logs")
}

model DiscoverySavedJob {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  jobId           String   @map("job_id")
  collection      String   @default("default")
  notes           String   @default("")
  status          String   @default("saved")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([jobId])
  @@unique([userId, jobId])
  @@map("discovery_saved_jobs")
}

model DiscoveryJobView {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  jobId           String   @map("job_id")
  viewCount       Int      @default(1) @map("view_count")
  firstViewedAt   DateTime @default(now()) @map("first_viewed_at")
  lastViewedAt    DateTime @default(now()) @map("last_viewed_at")

  @@index([userId])
  @@index([jobId])
  @@unique([userId, jobId])
  @@map("discovery_job_views")
}

model DiscoverySearchHistory {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  query           String
  filtersJson     Json     @default("{}") @map("filters_json")
  resultCount     Int      @default(0) @map("result_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("discovery_search_history")
}

model DiscoveryJobAnalytics {
  id              String   @id @default(cuid())
  date            DateTime @map("date")
  totalJobs       Int      @default(0) @map("total_jobs")
  newJobs         Int      @default(0) @map("new_jobs")
  activeSources   Int      @default(0) @map("active_sources")
  byLocation      Json     @default("{}") @map("by_location")
  bySkill         Json     @default("{}") @map("by_skill")
  byCompany       Json     @default("{}") @map("by_company")
  byIndustry      Json     @default("{}") @map("by_industry")
  salaryRanges    Json     @default("{}") @map("salary_ranges")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([date])
  @@index([date])
  @@map("discovery_job_analytics")
}

// ─── ADMIN DOMAIN MODELS ─────────────────────────────────────────

model AdminUser {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  password         String
  roleId           String?             @map("role_id")
  role             AdminRole?          @relation(fields: [roleId], references: [id])
  status           String              @default("ACTIVE")
  avatarUrl        String?             @map("avatar_url")
  lastLoginAt      DateTime?           @map("last_login_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  sessions         AdminSession[]
  auditLogs        AdminAuditLog[]
  loginHistory     AdminLoginHistory[]
  notifications    AdminNotification[]
  preferences      AdminPreference[]

  @@map("admin_users")
}

model AdminRole {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  users       AdminUser[]
  permissions AdminPermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String     @id @default(cuid())
  roleId      String     @map("role_id")
  resource    String
  action      String
  role        AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("admin_permissions")
}

model AdminSession {
  id          String     @id @default(cuid())
  adminId     String     @map("admin_id")
  token       String     @unique
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  admin       AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminId     String?    @map("admin_id")
  adminName   String?    @map("admin_name")
  action      String
  module      String
  targetId    String?    @map("target_id")
  details     Json       @default("{}")
  ipAddress   String?    @map("ip_address")
  createdAt   DateTime   @default(now()) @map("created_at")

  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
  @@index([module, createdAt])
  @@map("admin_audit_logs")
}

model AdminNotification {
  id          String     @id @default(cuid())
  adminId     String?    @map("admin_id")
  title       String
  message     String
  type        String     @default("info")
  isRead      Boolean    @default(false) @map("is_read")
  createdAt   DateTime   @default(now()) @map("created_at")

  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_notifications")
}

model SystemNotification {
  id              String   @id @default(cuid())
  adminId         String?  @map("admin_id")
  title           String
  message         String   @db.Text
  type            String   @default("info")
  targetAudience  String   @default("ALL") @map("target_audience")
  actionUrl       String?  @map("action_url")
  priority        String   @default("normal")
  deliveryChannel String   @default("in_app") @map("delivery_channel")
  sendEmail       Boolean  @default(false) @map("send_email")
  isRevoked       Boolean  @default(false) @map("is_revoked")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  reads           SystemNotificationRead[]

  @@index([targetAudience])
  @@index([createdAt])
  @@index([isRevoked, targetAudience, createdAt])
  @@map("system_notifications")
}

model SystemNotificationRead {
  id             String   @id @default(cuid())
  notificationId String   @map("notification_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  notification   SystemNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("system_notification_reads")
}

model AdminSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

model AdminLoginHistory {
  id          String    @id @default(cuid())
  adminId     String    @map("admin_id")
  email       String
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  status      String    @default("SUCCESS")
  createdAt   DateTime  @default(now()) @map("created_at")

  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_login_history")
}

model SystemMetric {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  cpuUsage    Float    @map("cpu_usage")
  memoryUsed  Float    @map("memory_used")
  memoryTotal Float    @map("memory_total")
  activeUsers Int      @default(0) @map("active_users")
  reqPerMin   Int      @default(0) @map("req_per_min")

  @@index([timestamp])
  @@map("system_metrics")
}

model Feature {
  id             String    @id @default(cuid())
  key            String    @unique
  name           String
  description    String?   @db.Text
  module         String    @default("System")
  category       String    @default("System")
  status         String    @default("Enabled")
  environment    String    @default("Production")
  accessLevel    String    @default("All") @map("access_level")
  version        String    @default("1.0.0")
  owner          String?
  isPremium      Boolean   @default(false) @map("is_premium")
  isBeta         Boolean   @default(false) @map("is_beta")
  apiEndpoint    String?   @map("api_endpoint")
  rateLimit      Int?      @map("rate_limit")
  notes          String?   @db.Text
  lastDeployedAt DateTime? @map("last_deployed_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([module])
  @@index([category])
  @@index([status])
  @@index([owner])
  @@map("features")
}

model FeatureFlag {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String?  @db.Text
  isEnabled          Boolean  @default(true) @map("is_enabled")
  rolloutPct         Int      @default(100) @map("rollout_pct")
  status             String   @default("Enabled")
  featureId          String?  @map("feature_id")
  environment        String   @default("Production")
  targetType         String   @default("all") @map("target_type")
  targetUsers        Json     @default("[]") @map("target_users")
  targetRoles        Json     @default("[]") @map("target_roles")
  targetUniversities Json     @default("[]") @map("target_universities")
  targetCountries    Json     @default("[]") @map("target_countries")
  updatedBy          String?  @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([featureId])
  @@unique([featureId, environment])
  @@map("feature_flags")
}

model FeatureDependency {
  id          String   @id @default(cuid())
  featureId   String   @map("feature_id")
  dependsOnId String   @map("depends_on_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([featureId, dependsOnId])
  @@index([featureId])
  @@index([dependsOnId])
  @@map("feature_dependencies")
}

model FeatureUsage {
  id             String   @id @default(cuid())
  featureId      String   @map("feature_id")
  date           DateTime
  requests       Int      @default(0)
  users          Int      @default(0)
  successCount   Int      @default(0) @map("success_count")
  errorCount     Int      @default(0) @map("error_count")
  avgResponseMs  Int      @default(0) @map("avg_response_ms")
  revenueGenerated Float  @default(0) @map("revenue_generated")
  aiTokensUsed   BigInt   @default(0) @map("ai_tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([featureId, date])
  @@index([featureId])
  @@map("feature_usage")
}

model FeatureRollout {
  id                 String   @id @default(cuid())
  featureId          String   @map("feature_id")
  environment        String   @default("Production")
  rolloutPct         Int
  isEnabled          Boolean
  targetType         String   @default("all") @map("target_type")
  targetRoles        Json     @default("[]") @map("target_roles")
  targetUsers        Json     @default("[]") @map("target_users")
  targetUniversities Json     @default("[]") @map("target_universities")
  targetCountries    Json     @default("[]") @map("target_countries")
  changedBy          String?  @map("changed_by")
  reason             String?
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([featureId])
  @@map("feature_rollouts")
}

model FeaturePermission {
  id                 String   @id @default(cuid())
  featureId          String   @map("feature_id")
  role               String
  canView            Boolean  @default(true) @map("can_view")
  canEdit            Boolean  @default(false) @map("can_edit")
  canToggle          Boolean  @default(false) @map("can_toggle")
  canRollout         Boolean  @default(false) @map("can_rollout")
  canDelete          Boolean  @default(false) @map("can_delete")
  canManagePermissions Boolean @default(false) @map("can_manage_permissions")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([featureId, role])
  @@map("feature_permissions")
}

model FeatureLog {
  id        String   @id @default(cuid())
  featureId String   @map("feature_id")
  action    String
  changedBy String?
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([featureId])
  @@index([createdAt])
  @@map("feature_logs")
}

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  discountPct       Float     @map("discount_pct")
  planCodes         String[]  @default([]) @map("plan_codes")
  minAmount         Float?    @map("min_amount")
  maxDiscountAmount Float?    @map("max_discount_amount")
  validUntil        DateTime? @map("valid_until")
  maxUses           Int?      @map("max_uses")
  usedCount         Int       @default(0) @map("used_count")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  priceMonthly Float    @map("price_monthly")
  priceYearly  Float    @map("price_yearly")
  features     Json     @default("[]")
  isActive     Boolean  @default(true) @map("is_active")
  category     String   @default("premium")
  recommended  Boolean  @default(false)
  sortOrder    Int      @default(0) @map("sort_order")
  trialDays    Int      @default(0) @map("trial_days")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("plans")
}

model RevenueReport {
  id            String   @id @default(cuid())
  date          DateTime @unique
  grossRevenue  Float    @default(0) @map("gross_revenue")
  netRevenue    Float    @default(0) @map("net_revenue")
  newSubscribers Int     @default(0) @map("new_subscribers")
  churnCount    Int      @default(0) @map("churn_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("revenue_reports")
}

model AdminPreference {
  id          String    @id @default(cuid())
  adminId     String    @map("admin_id")
  theme       String    @default("dark")
  dashboardConfig Json  @default("{}") @map("dashboard_config")
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId])
  @@map("admin_preferences")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENTERPRISE SUBSCRIPTION SYSTEM — Billing, Payments & Feature Access
// ═══════════════════════════════════════════════════════════════════════════

// Immutable payment/refund ledger rows. One row per charge or refund across
// any provider (razorpay, stripe, paypal, mock).
model Transaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  paymentId   String?  @map("payment_id")
  orderId     String?  @map("order_id")
  type        String   @default("payment") // payment | refund | adjustment
  provider    String   @default("razorpay")
  providerRef String?  @map("provider_ref")
  amount      Int
  currency    String   @default("INR")
  status      String   @default("pending") // pending | succeeded | failed | refunded
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([type, status])
  @@map("transactions")
}

// Saved payment methods (cards / upi / netbanking / paypal tokens).
model PaymentMethod {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  provider     String   @default("razorpay")
  type         String   @default("card") // card | upi | netbanking | paypal
  brand        String?  @default("") // visa, mastercard, ...
  last4        String?  @map("last_4")
  expiryMonth  String?  @map("expiry_month")
  expiryYear   String?  @map("expiry_year")
  holderName   String?  @map("holder_name")
  email        String?
  providerToken String? @map("provider_token")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payment_methods")
}

// Billing address for invoice generation.
model BillingAddress {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  name       String?
  email      String?
  phone      String?
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?  @map("postal_code")
  country    String   @default("IN")
  gstin      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("billing_addresses")
}

// Generated invoice records (one per successful payment/refund).
model Invoice {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  invoiceNumber  String    @unique @map("invoice_number")
  paymentId      String?   @map("payment_id")
  subscriptionId String?   @map("subscription_id")
  plan           String?
  description    String    @default("")
  amount         Int
  taxAmount      Int       @default(0) @map("tax_amount")
  currency       String    @default("INR")
  status         String    @default("paid") // paid | refunded | void
  issuedAt       DateTime  @default(now()) @map("issued_at")
  dueAt          DateTime? @map("due_at")
  paidAt         DateTime? @map("paid_at")
  downloadUrl    String?   @map("download_url")

  @@index([userId])
  @@index([issuedAt])
  @@map("invoices")
}

// Admin-configurable per-feature, per-plan usage quotas.
// featureKey maps to a feature in the FeatureAccess catalog.
model UsageLimit {
  id          String   @id @default(cuid())
  featureKey  String   @map("feature_key")
  planCode    String   @map("plan_code")
  dailyLimit  Int?     @map("daily_limit")
  monthlyLimit Int?    @map("monthly_limit")
  tokenLimit  Int?     @map("token_limit")
  storageMb   Float?   @map("storage_mb")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([featureKey, planCode])
  @@index([planCode])
  @@map("usage_limits")
}

// Feature → required-plan access catalog. Every AI feature is gated here.
// requiredPlan: free | premium | enterprise. Admins can toggle `gated`.
model FeatureAccess {
  id           String   @id @default(cuid())
  featureKey   String   @unique @map("feature_key")
  name         String
  description  String?  @db.Text
  category     String   @default("AI Productivity")
  requiredPlan String   @default("premium") @map("required_plan")
  routePattern String?  @map("route_pattern")
  gated        Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([requiredPlan])
  @@map("feature_access")
}

