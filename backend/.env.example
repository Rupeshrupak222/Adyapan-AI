# ======================
# Backend Environment Variables
# ======================
# Copy this file to .env and fill in your values.
# For Railway, set these in your service's Variables tab.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=verify-full
MASTER_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# --- Neon API (for per-user database provisioning) ---
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_REGION_ID=aws-us-east-1

# --- Server ---
PORT=5000
# MUST be "production" on any live/deployed host. Leaving this as "development"
# in production disables rate limiting, exposes OTPs in API responses, and leaks
# error details. Set NODE_ENV=production in the host's env vars (Railway/Vercel),
# never rely on a committed .env file for this.
NODE_ENV=development

# --- Security ---
# Generate with:  openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret
# NOTE: Admin self-registration is permanently disabled. Do NOT set
# ADMIN_REGISTER_SECRET — the app refuses to boot in production if the old
# default value is present. New admins are created only by an existing admin.
# Comma-separated list of emails permitted to create/promote admin accounts.
# Only these accounts can mint new admins; all other admins are restricted.
SUPER_ADMIN_EMAILS=owner1@example.com,owner2@example.com
# Explicit opt-in for the local native code-execution fallback (dev only).
# Production always forbids native execution regardless of this flag.
ALLOW_NATIVE_EXEC=false
# When true, password-reset OTPs are printed to the server log as the delivery
# channel (no SMTP bundled). Default OFF so reset codes are never logged.
ALLOW_OTP_LOG_DELIVERY=false
# Global per-IP API rate limit (requests per minute). Tune per deployment.
GLOBAL_RATE_LIMIT_PER_MIN=300

# --- Frontend (for CORS) ---
FRONTEND_URL=https://adyapan-ai-gamma.vercel.app
# Comma-separated extra CORS origins allowed in addition to the defaults in app.ts
CORS_ORIGINS=

# --- AI Providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- File Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://ai.adyapan.com/api/auth/github/callback

# --- Codeforces ---
CODEFORCES_API_KEY=
# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ai.adyapan.com/api/auth/google/callback

# --- NVIDIA (Embedding) ---
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=

# --- Job Discovery (Adzuna) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Job Discovery (Apify) ---
APIFY_API_KEY=
APIFY_TOKEN=

# --- AI Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=

# --- Piston Code Execution ---
PISTON_URL=http://localhost:2000
