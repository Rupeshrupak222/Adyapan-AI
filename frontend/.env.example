# ======================
# Frontend Environment Variables
# ======================
# Copy this file to .env and fill in your values.
# For Vercel, set these in Project Settings > Environment Variables.

# Backend API base URL (no trailing slash)
# NEXT_PUBLIC_API_URL=https://adyapan-ai.up.railway.app/api
# Railway Internal: http://adyapan-ai.railway.internal:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api



# Razorpay public key (safe to expose — used in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
