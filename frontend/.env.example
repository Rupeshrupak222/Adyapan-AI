# ======================
# Frontend Environment Variables
# ======================
# Copy this file to .env and fill in your values.
# For Vercel, set these in Project Settings > Environment Variables.

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://adyapan-ai-production.up.railway.app/api

# Site URL used for sitemap.xml, robots.txt, and SEO metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://ai.adyapan.com

# Logo.dev public token (optional, used for company logo lookup)
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Razorpay public key (safe to expose — used in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID
