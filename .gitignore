.aider*

# dependencies
node_modules/

# local environment files (never commit real secrets)
.env
.env.*
!.env.example

# local Python tooling virtualenv
.venv311/

# runtime logs & build artifacts
*.log
logs/
*.tsbuildinfo
.next/

# question-bank backfill runtime state & generated reports
backend/data/*.pid
backend/data/regeneration-report.json
backend/data/question-backfill-shortfall.json
backend/data/backfill-*.log
backend/data/backfill*.log
# pre-dedupe safety backups (large, local-only rollback artifacts)
backend/data/*.pre-dedupe.*.json
backend/data/*.pre-*dedupe.*.json
# per-run question backfill / replacement snapshots (same rationale: rollback-only)
backend/data/*.pre-backfill.*.json
backend/data/*.pre-replace.*.json

# Private, local-only security presentation artifacts (never commit/push)
Adyapan-AI-Security-Features.pptx
Adyapan-AI-Security-Features.pdf
scripts/build_security_ppt.py
